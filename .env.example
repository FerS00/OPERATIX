# Copy this file to .env.local and fill only the providers you will use.
# Never commit .env.local.

# LLM providers (all are optional; at least one is needed to run the agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Persistence: excel or google_sheets
OPERATIX_STORAGE_BACKEND=excel
OPERATIX_EXCEL_PATH=data/operatix.xlsx

# FastAPI/MySQL foundation (required by the backend and Docker Compose)
APP_NAME=OPERATIX API
APP_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=operatix
MYSQL_USER=operatix
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only
# Optional: overrides the MYSQL_* variables when connecting outside Docker.
DATABASE_URL=

# Required only when OPERATIX_STORAGE_BACKEND=google_sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Ventas
GOOGLE_APPLICATION_CREDENTIALS=.secrets/google-service-account.json

# Optional LangSmith observability (recommended after the MVP works)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=operatix-mvp
